# Copy to .env to enable real Gemini calls. With no .env at all, the stack
# runs fully offline: AI_PROVIDER defaults to "fake".

# AI_PROVIDER=gemini
# GEMINI_API_KEY=

# JWT_SECRET=change-me-in-real-deployments

# Overrides (defaults already match docker-compose service names):
# DATABASE_URL=postgresql+asyncpg://ticketing:ticketing@db:5432/ticketing
# REDIS_URL=redis://redis:6379/0
