# Copy to .env to enable real Gemini calls. With no .env at all, the stack
# runs fully offline on the deterministic fake AI provider.

# Setting a key is enough: AI_PROVIDER defaults to "auto" (Gemini when
# GEMINI_API_KEY is set, the fake otherwise). Set AI_PROVIDER=fake to force
# the fake even with a key. Restart the stack after adding a key so the seed
# re-embeds the knowledge base with Gemini.
# GEMINI_API_KEY=
# AI_PROVIDER=auto

# JWT_SECRET=change-me-in-real-deployments

# Overrides (defaults already match docker-compose service names):
# DATABASE_URL=postgresql+asyncpg://ticketing:ticketing@db:5432/ticketing
# REDIS_URL=redis://redis:6379/0
